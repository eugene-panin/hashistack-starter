#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
group=$root/ansible/inventory/group_vars/stack/vault.yml
host=$root/ansible/inventory/host_vars/vps/vault.yml
ca=$root/ansible/files/ca.pem
password_file=${ANSIBLE_VAULT_PASSWORD_FILE:?run through make, or set ANSIBLE_VAULT_PASSWORD_FILE}

for f in "$group" "$host" "$ca"; do
  [[ ! -e $f ]] || { echo "$f exists: the secrets are generated once" >&2; exit 1; }
done

umask 077
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

if [[ ! -f $password_file ]]; then
  mkdir -p "$(dirname "$password_file")"
  openssl rand -base64 48 >"$password_file"
  echo "created the Ansible vault password at $password_file: back it up, nothing can be decrypted without it" >&2
fi

openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 3650 \
  -subj "/CN=$(basename "$root") CA" \
  -addext "basicConstraints=critical,CA:TRUE" \
  -addext "keyUsage=critical,keyCertSign,cRLSign,digitalSignature" \
  -keyout "$work/ca.key" -out "$work/ca.pem" 2>/dev/null

uuid() { python3 -c 'import uuid; print(uuid.uuid4())'; }
gossip() { openssl rand -base64 32; }

{
  echo "---"
  echo "vault_stack_ca_key: |"
  sed 's/^/  /' "$work/ca.key"
  echo "vault_consul_gossip_key: \"$(gossip)\""
  echo "vault_consul_acl_bootstrap_token: \"$(uuid)\""
  echo "vault_consul_acl_dns_token: \"$(uuid)\""
  echo "vault_nomad_gossip_key: \"$(gossip)\""
  echo "vault_nomad_acl_bootstrap_token: \"$(uuid)\""
  echo "vault_nomad_consul_token: \"$(uuid)\""
  echo "vault_tofu_state_passphrase: \"$(openssl rand -hex 32)\""
} >"$work/group.yml"

{
  echo "---"
  echo "vault_consul_acl_agent_token: \"$(uuid)\""
} >"$work/host.yml"

mkdir -p "$(dirname "$group")" "$(dirname "$host")" "$(dirname "$ca")"
ansible-vault encrypt --vault-password-file "$password_file" --output "$group" "$work/group.yml"
ansible-vault encrypt --vault-password-file "$password_file" --output "$host" "$work/host.yml"
install -m 0644 "$work/ca.pem" "$ca"

echo "wrote $ca and the encrypted $group and $host" >&2
